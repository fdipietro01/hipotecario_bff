# ---------- SERVIDOR ----------
PORT=4000

# ---------- DATOS DEL CRÉDITO (← MODIFICAR CON TUS VALORES) ----------
# Total del crédito expresado en UVAs. Es fijo (se recibe como parámetro).
LOAN_TOTAL_UVA=0
# UVAs pagadas a la fecha (suma de cuotas pagadas en UVA).
LOAN_PAID_UVA=0
# Valor inicial del crédito en pesos (al momento del desembolso). Solo se muestra.
LOAN_INITIAL_ARS=0
# Valor inicial del crédito en dólares (opcional, solo se muestra).
LOAN_INITIAL_USD=
# Pesos nominales pagados a la fecha (opcional). Si se deja vacío se calcula
# como UVA pagadas × valor UVA de hoy.
LOAN_PAID_ARS=

# ---------- FUENTES DE DATOS (← CAMBIAR SOLO SI LAS APIs CAMBIAN) ----------
# Serie UVA en la API de Estadísticas del BCRA (v3.0, Monetarias).
# Verificar el ID vigente en https://estadisticasbcra.com/ o en la documentación del BCRA.
BCRA_UVA_SERIES_ID=31
# Dólar oficial (venta). Por defecto: dolarapi.com
FX_URL=https://dolarapi.com/v1/dolares/oficial

# ---------- CACHE ----------
# Tiempo de cache en minutos para no consultar las APIs en cada request.
CACHE_TTL_MINUTES=60
